{
  "languages": {
    "Go": {
      "language_servers": ["gopls", "!typescript-language-server"]
    },
    "SQL": {
      "language_servers": ["sql-language-server"]
    }
  },
  "lsp": {
    "gopls": {
      "binary": {
        "path_lookup": true
      },
      "initialization_options": {
        "gopls": {
          "usePlaceholders": true
        }
      }
    }
  }
}