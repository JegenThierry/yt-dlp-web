# =========================
# Database (required)
# =========================
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=yt-dlp-db

# =========================
# Traefik (required)
# =========================
APP_HOST=yt-dlp.example.com # Hostname for Traefik

# =========================
# yt-dlp (optional)
# =========================
# Pin a yt-dlp release, e.g. 2026.10.10. Empty installs the latest at build time.
# YTDLP_VERSION=

# Cookies for age-restricted videos, the "not a bot" check or Premium audio.
# Path inside the container; ./cookies is mounted at /data/cookies.
# YT_COOKIES_FILE=/data/cookies/cookies.txt
