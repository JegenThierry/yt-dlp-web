# =========================
# Database Configuration
# =========================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yt-dlp-db
DB_HOST=localhost
DB_PORT=5432

# =========================
# API Configuration
# =========================
API_PORT=8080
DOWNLOAD_DIR=./downloads

# Optional YouTube authentication (for a YouTube Premium account / higher
# quality source formats). Sets yt-dlp's --cookies-from-browser or --cookies.
# If both are set, the cookies file takes precedence. Leave unset to disable.
# YT_COOKIES_FROM_BROWSER=firefox        # e.g. firefox, chrome, safari
# YT_COOKIES_FILE=/path/to/cookies.txt

# =========================
# UI Configuration (Vite)
# =========================
VITE_API_BASE_URL=http://localhost:8080/api
